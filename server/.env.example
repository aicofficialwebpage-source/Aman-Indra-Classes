PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aman_indra_classes
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Cloudinary (Optional - Backend will fallback to local folder storage if not provided)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configurations (Optional - Backend falls back to mock console outbox if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=admissions@amanindraclasses.com

# EmailJS Configurations (Optional - alternative to SMTP)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
